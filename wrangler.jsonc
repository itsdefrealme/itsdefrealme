{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itsdefrealme",
  "compatibility_date": "2026-09-30",
  // out/ is the Next static export; the tiny worker only adds Range support
  // for the videos (iOS Safari needs 206)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  }
}
